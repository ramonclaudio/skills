{
  "description": "Session continuity hooks. Injects resume context on startup and after compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/resume-inject.sh",
            "timeout": 5,
            "statusMessage": "Loading handoff context..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/resume-inject.sh",
            "timeout": 5,
            "statusMessage": "Re-injecting handoff context..."
          }
        ]
      }
    ]
  }
}
