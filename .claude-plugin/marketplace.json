{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "skills",
  "owner": {
    "name": "ramonclaudio",
    "email": "hello@ramonclaudio.com"
  },
  "metadata": {
    "description": "Custom Claude Code skills by @ramonclaudio"
  },
  "plugins": [
    {
      "name": "commit",
      "source": "./plugins/commit",
      "description": "Atomic commits with conventional format, grouped by architectural layer. GPG signs when available.",
      "version": "1.4.0",
      "author": {
        "name": "ramonclaudio",
        "email": "hello@ramonclaudio.com"
      },
      "homepage": "https://github.com/ramonclaudio/skills/tree/main/plugins/commit",
      "category": "development",
      "keywords": ["git", "commit", "conventional-commits", "gpg"],
      "license": "MIT",
      "repository": "https://github.com/ramonclaudio/skills"
    },
    {
      "name": "polish",
      "source": "./plugins/polish",
      "description": "Full codebase sweep that scores every file 0-10 on polish potential and refines files scoring 5+. Unlike built-in /simplify (recently changed files only), /polish analyzes all source files.",
      "version": "1.3.0",
      "author": {
        "name": "ramonclaudio",
        "email": "hello@ramonclaudio.com"
      },
      "homepage": "https://github.com/ramonclaudio/skills/tree/main/plugins/polish",
      "category": "development",
      "keywords": ["refactor", "polish", "codebase", "analysis", "quality"],
      "license": "MIT",
      "repository": "https://github.com/ramonclaudio/skills"
    },
    {
      "name": "audit",
      "source": "./plugins/audit",
      "description": "Brutally honest codebase audit with parallel agents. Finds bugs, architectural rot, and dead weight.",
      "version": "1.3.0",
      "author": {
        "name": "ramonclaudio",
        "email": "hello@ramonclaudio.com"
      },
      "homepage": "https://github.com/ramonclaudio/skills/tree/main/plugins/audit",
      "category": "development",
      "keywords": ["audit", "review", "bugs", "security", "architecture", "quality"],
      "license": "MIT",
      "repository": "https://github.com/ramonclaudio/skills"
    },
    {
      "name": "gif",
      "source": "./plugins/gif",
      "description": "Convert screen recordings to compressed GIFs using ffmpeg two-pass palette method",
      "version": "1.3.0",
      "author": {
        "name": "ramonclaudio",
        "email": "hello@ramonclaudio.com"
      },
      "homepage": "https://github.com/ramonclaudio/skills/tree/main/plugins/gif",
      "category": "utility",
      "keywords": ["video", "ffmpeg", "gif", "conversion", "screen-recording"],
      "license": "MIT",
      "repository": "https://github.com/ramonclaudio/skills"
    },
    {
      "name": "frames",
      "source": "./plugins/frames",
      "description": "Extract video frames as images so Claude can analyze screen recordings, bug reproductions, and demos",
      "version": "1.3.0",
      "author": {
        "name": "ramonclaudio",
        "email": "hello@ramonclaudio.com"
      },
      "homepage": "https://github.com/ramonclaudio/skills/tree/main/plugins/frames",
      "category": "utility",
      "keywords": ["video", "ffmpeg", "frames", "extraction"],
      "license": "MIT",
      "repository": "https://github.com/ramonclaudio/skills"
    },
    {
      "name": "handoff",
      "source": "./plugins/handoff",
      "description": "Session continuity for Claude Code. Structured handoffs preserve context across sessions, machines, and compactions.",
      "version": "1.3.0",
      "author": {
        "name": "ramonclaudio",
        "email": "hello@ramonclaudio.com"
      },
      "homepage": "https://github.com/ramonclaudio/skills/tree/main/plugins/handoff",
      "category": "workflow",
      "keywords": ["session", "continuity", "handoff", "context", "sbar"],
      "license": "MIT",
      "repository": "https://github.com/ramonclaudio/skills"
    },
    {
      "name": "qmd",
      "source": "./plugins/qmd",
      "description": "Reference repo manager. Clone GitHub repos, index with QMD, search with BM25/vector/hybrid, manage embeddings and models -- all on-device.",
      "version": "1.5.0",
      "author": {
        "name": "ramonclaudio",
        "email": "hello@ramonclaudio.com"
      },
      "homepage": "https://github.com/ramonclaudio/skills/tree/main/plugins/qmd",
      "category": "development",
      "keywords": ["qmd", "search", "embeddings", "vector", "semantic", "reference", "mcp", "reranking", "hybrid-search", "gguf", "llm", "cli"],
      "license": "MIT",
      "repository": "https://github.com/ramonclaudio/skills"
    },
    {
      "name": "techdebt",
      "source": "./plugins/techdebt",
      "description": "Lightweight end-of-session tech debt sweep. Finds duplicated code, dead exports, unused deps, stale TODOs, and bloated files.",
      "version": "1.3.0",
      "author": {
        "name": "ramonclaudio",
        "email": "hello@ramonclaudio.com"
      },
      "homepage": "https://github.com/ramonclaudio/skills/tree/main/plugins/techdebt",
      "category": "development",
      "keywords": ["techdebt", "duplicates", "dead-code", "unused-deps", "todos", "cleanup"],
      "license": "MIT",
      "repository": "https://github.com/ramonclaudio/skills"
    },
    {
      "name": "teams",
      "source": "./plugins/teams",
      "description": "Orchestrate teams of Claude Code sessions working in parallel. Decomposes work, spawns teammates, assigns tasks with file ownership, and coordinates execution.",
      "version": "1.2.0",
      "author": {
        "name": "ramonclaudio",
        "email": "hello@ramonclaudio.com"
      },
      "homepage": "https://github.com/ramonclaudio/skills/tree/main/plugins/teams",
      "category": "workflow",
      "keywords": ["teams", "orchestration", "parallel", "agents", "coordination", "delegation"],
      "license": "MIT",
      "repository": "https://github.com/ramonclaudio/skills"
    }
  ]
}
